# Environment Variables for EventSnap Frontend
# Copy this file to .env and fill in the values.
# NEVER commit the real .env to git!

# API Gateway base URL — filled in AFTER sam deploy outputs it
VITE_API_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com/prod

# Cognito — values from your ap-south-1_ZTFnmRCOL user pool
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_ZTFnmRCOL
VITE_COGNITO_CLIENT_ID=3rfiq50j7npic6a5fg6nmjbhu6

# For local dev use http://localhost:5173
# For Amplify production use your Amplify app URL
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
