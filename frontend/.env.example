# Prism — Frontend Environment Variables
# Copy to .env and fill in values. Never commit .env.

VITE_API_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com/prod

VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXX
VITE_COGNITO_CLIENT_ID=YOUR_APP_CLIENT_ID
VITE_COGNITO_DOMAIN=prism-auth-XXXXXXXXXXXX
# Local dev: http://localhost:5173  |  Production: https://your-amplify-url.amplifyapp.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
